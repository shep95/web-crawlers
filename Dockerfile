# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
# Chromium is used only for selective rendering of JS-dependent pages (RENDER_JS=on).
ARG INSTALL_BROWSER=true
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATA_DIR=/data \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
  && rm -rf /var/lib/apt/lists/* && mkdir -p /data
COPY --from=build /app/node_modules ./node_modules
RUN if [ "$INSTALL_BROWSER" = "true" ]; then npx --no-install playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*; fi
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY config ./config
# Geography registry data (ISO 3166-1 / non-ISO / ISO 3166-2), generated by scripts/build-geography.ts.
COPY geography ./geography
COPY public ./public
EXPOSE 8080
# Root user so a Railway volume mounted at /data (root-owned) is writable in single-node mode.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--max-old-space-size=1536", "dist/cli.js", "serve"]
