# --- Server
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# --- Corpus storage
DATABASE_URL=                   # Postgres (required for multiple API/crawler replicas). Railway: ${{Postgres.DATABASE_URL}}
DATA_DIR=/data                  # SQLite fallback when DATABASE_URL is empty (single node; mount a volume)
PG_POOL_MAX=10

# --- Service role
SERVICE_ROLE=all                # all | api | crawler

# --- Autonomous crawler
CRAWLER_ENABLED=on              # "off" to run the API only
CRAWLER_PROFILES=generalist,datasets,media,documents,refresh   # crawlers started in this process
RENDER_JS=off                   # "on": headless Chromium for JS-only pages (crawler service)
OCR_ENABLED=on                  # Tesseract OCR for images without embedded descriptive text
TOPICAL_DISCOVERY=on            # thin search results queue candidate discovery via public APIs
HEARTBEAT_MS=300000
CRAWL_CONCURRENCY=4             # resources in flight (max one per host)
HOST_DELAY_MS=2000              # minimum per-host politeness delay (raised to robots Crawl-delay)
HOST_BUDGET=400                 # max resources enqueued per host
CRAWL_MAX_DEPTH=6
CRAWL_MAX_BYTES=20971520        # per-resource retrieval cap
CRAWL_ENRICH=on                 # DNS / TLS / Wayback / Crossref / registry enrichment on first retrieval
BOOTSTRAP_SOURCES=              # comma list to restrict discovery sources (default: all)
SNAPSHOTS_PER_RESOURCE=5
EVENT_RETENTION_DAYS=30

# --- Access control
API_KEYS=                       # comma separated keys or sha256:<hex>; required for crawler pause/resume
CORS_ORIGIN=                    # "*" or comma-separated frontend origins
PUBLIC_URL=                     # advertised in /api/v2/openapi.json
RATE_LIMIT_PER_MIN=120
HEAVY_RATE_LIMIT_PER_MIN=20

# --- Optional
GITHUB_TOKEN_PUBLIC=            # raises GitHub API rate limits for enrichment
LEGACY_API=off                  # legacy v1 routes (require API_KEYS in production)
