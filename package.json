{
  "name": "omnispider",
  "version": "2.0.0",
  "description": "Stateless web metadata intelligence engine: federated search, crawling and 41-category metadata extraction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "omnispider": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js serve --host 0.0.0.0",
    "sync:deep-web": "node dist/cli.js deep-web sync-all",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "coverage:matrix": "tsx scripts/coverage-matrix.ts",
    "geography:build": "tsx scripts/build-geography.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "exifr": "^7.1.3",
    "fastify": "^5.2.0",
    "iconv-lite": "^0.7.3",
    "image-size": "^1.2.1",
    "js-yaml": "^4.1.0",
    "music-metadata": "^10.9.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "playwright": "^1.49.0",
    "robots-parser": "^3.0.1",
    "tesseract.js": "^5.1.1",
    "undici": "^6.29.1",
    "unpdf": "^0.12.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "autocannon": "^7.15.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "i18n-iso-countries": "^7.14.0",
    "iso-3166": "^4.4.0",
    "iso-639-3": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "un-m49": "^2.2.0",
    "vitest": "^2.1.8",
    "world-countries": "^5.1.0"
  }
}
